{
  "name": "dbbs-faculty-match",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "tauri": "node ./scripts/run-tauri.mjs",
    "build-sidecars": "node ./scripts/build-sidecars.mjs",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:backend": "node ./scripts/check-backend.mjs test",
    "format": "prettier --write src vite.config.ts vitest.config.ts",
    "format:check": "prettier --check src vite.config.ts vitest.config.ts",
    "check": "npm run format:check && npm run build && npm test",
    "lint:backend": "node ./scripts/check-backend.mjs lint"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.12.4",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "~2.12.4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
